# Copy to backend/.env (never commit .env). All values are optional; defaults shown.

# development | production. Production disables /docs, drops the localhost CORS
# wildcard and preloads the SHAP explainer at startup.
ENVIRONMENT=development

# Browser origins allowed to call the API (JSON list). Set to your frontend URL in production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Serve the model without PageValues (default) or the benchmark with PageValues.
# PREDICTION_MODEL_VARIANT=without_page_values

# Interactive docs (/docs, /openapi.json). Empty = on in development only.
# ENABLE_DOCS=false

# Max simultaneous SHAP explanations per process; extra requests get HTTP 429.
# EXPLAIN_MAX_CONCURRENCY=4

# Build the SHAP explainer at startup. Empty = production only.
# PRELOAD_EXPLAINER=true

# --- Website Intelligence (POST /api/analyze-website) ---
# The server makes outbound HTTP(S) requests to public websites (SSRF-protected).
# WEBSITE_ANALYSIS_ENABLED=true
# Analyses allowed per client IP per window (seconds); extra requests get HTTP 429.
# WEBSITE_RATE_LIMIT=10
# WEBSITE_RATE_WINDOW_S=600
# Simultaneous analyses per process; extra requests get HTTP 429.
# WEBSITE_MAX_CONCURRENCY=2
# Optional Google PageSpeed Insights key (SECRET - set it in the host's secret store, never commit).
# Without it, performance / Core Web Vitals are reported as "unavailable".
# PAGESPEED_API_KEY=
